# Synapse Backend Environment Variables
# Copy to .env and fill in your tokens

# Ollama (optional - defaults to localhost:11434)
OLLAMA_URL=http://localhost:11434

# GitHub (Personal Access Token)
GITHUB_TOKEN=ghp_your_token_here

# Notion (Integration Token)
NOTION_TOKEN=secret_your_notion_token_here

# Jira (Atlassian site)
JIRA_SERVER=https://your-site.atlassian.net
JIRA_EMAIL=your.email@company.com
JIRA_TOKEN=your_jira_api_token_here

# Slack (Bot Token)
SLACK_TOKEN=xoxb-your_slack_bot_token_here

# Discord (Bot Token)
DISCORD_TOKEN=Bot_your_discord_bot_token_here

# Debug
DEBUG=true
