# Optional: otherwise the backend creates backend/.synapse/api-token.
# Use a random token with at least 32 characters; never commit a real value.
# SYNAPSE_API_TOKEN=
# SYNAPSE_DATA_DIR=E:/SynapseData
# SYNAPSE_EMBEDDING_DIR=E:/SynapseData/models/minilm
# Optional installed ONNX execution provider; CPU is the supported default.
# SYNAPSE_ONNX_PROVIDER=CPUExecutionProvider
